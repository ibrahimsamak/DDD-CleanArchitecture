<!-- tests/Directory.Build.props — the root settings, minus the rules that fight test code. -->
<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove($(MSBuildThisFileName)$(MSBuildThisFileExtension), $(MSBuildThisFileDirectory)../))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      CA1707 — Given_When_Then method names are the point of a test suite.
      CA2007 — there is no synchronization context to capture in a test host.
      CA1861 — inline arrays in assertions are more readable than hoisted statics.
      CA1515 — xUnit discovers public test classes; it cannot see internal ones.
    -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;CA1515</NoWarn>
  </PropertyGroup>

</Project>
